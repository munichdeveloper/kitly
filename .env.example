# ===================================
# Kitly Backend - Umgebungsvariablen
# ===================================

# =================
# Datenbank
# =================
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/kitly
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=postgres

# =================
# JWT Token
# =================
JWT_SECRET=your-secret-key-here-please-change-in-production
JWT_SESSION_SECRET=your-session-secret-key-here

# =================
# Frontend
# =================
FRONTEND_URL=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3002

# =================
# E-Mail-Verifizierung
# =================
# Aktivieren/Deaktivieren der E-Mail-Verifizierung
# true  = Benutzer muss E-Mail bestätigen, bevor das Konto erstellt wird
# false = Benutzer wird sofort erstellt (Standard)
EMAIL_VERIFICATION_ENABLED=false

# Gültigkeit des Verifizierungs-Tokens in Stunden
EMAIL_VERIFICATION_TOKEN_VALIDITY_HOURS=24

# =================
# E-Mail-Server
# =================
# Nur erforderlich, wenn EMAIL_VERIFICATION_ENABLED=true

# Gmail Beispiel:
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-gmail-app-password
MAIL_FROM=noreply@kitly.com

# SendGrid Beispiel:
# MAIL_HOST=smtp.sendgrid.net
# MAIL_PORT=587
# MAIL_USERNAME=apikey
# MAIL_PASSWORD=your-sendgrid-api-key
# MAIL_FROM=verified-sender@yourdomain.com

# AWS SES Beispiel:
# MAIL_HOST=email-smtp.eu-central-1.amazonaws.com
# MAIL_PORT=587
# MAIL_USERNAME=your-smtp-username
# MAIL_PASSWORD=your-smtp-password
# MAIL_FROM=verified-sender@yourdomain.com

# MailHog (Lokales Testing):
# MAIL_HOST=localhost
# MAIL_PORT=1025
# MAIL_USERNAME=
# MAIL_PASSWORD=
# MAIL_FROM=noreply@kitly.com

# =================
# Stripe (Optional)
# =================
STRIPE_API_KEY=your-stripe-api-key
STRIPE_WEBHOOK_SECRET=your-webhook-secret

# =================
# Hinweise
# =================
#
# Gmail App-Passwort erstellen:
# 1. https://myaccount.google.com/security
# 2. 2-Faktor-Authentifizierung aktivieren
# 3. https://myaccount.google.com/apppasswords
# 4. App-Passwort generieren und als MAIL_PASSWORD verwenden
#
# MailHog für lokales Testing:
# docker run -d -p 1025:1025 -p 8025:8025 mailhog/mailhog
# Web-UI: http://localhost:8025

