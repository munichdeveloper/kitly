# Rename to .env and fill in the values
CORS_ALLOWED_ORIGINS=https://landingpage.example,https://app.example.com
POSTGRES_PASSWORD=postgrespassword
FRONTEND_API_URL=http://backend/api
FRONTEND_URL=https://landing-page.example.com
FRONTEND_APP_URL=https://app.example.com

# E-Mail-Konfiguration
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password
MAIL_FROM=noreply@kitly.com

# E-Mail-Verifizierung
EMAIL_VERIFICATION_ENABLED=true
EMAIL_VERIFICATION_TOKEN_VALIDITY_HOURS=24

# E-Mail-Template-Konfiguration
EMAIL_LOCALE=de_DE
EMAIL_BRANDING=kitly